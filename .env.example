# Configuración de DataTab. Son variables de entorno: la aplicación NO lee este
# archivo por sí sola. Si no defines una variable se usa el valor indicado aquí.
#
# PowerShell:  $env:DATATAB_PORT = "8001"; python -m app
# Bash:        DATATAB_PORT=8001 python -m app

# Tamaño máximo del archivo subido, en MB (entero).
# DATATAB_MAX_MB=5

# Minutos de inactividad tras los que se borra un archivo de la memoria.
# DATATAB_TTL_MIN=30

# Dirección y puerto de `python -m app`. Con 127.0.0.1 solo se accede desde este equipo.
# DATATAB_HOST=127.0.0.1
# DATATAB_PORT=8000

# Límites de la tabla leída.
# DATATAB_MAX_FILAS=100000
# DATATAB_MAX_COLUMNAS=200
# DATATAB_MAX_CELDAS=2000000

# Máximo de valores distintos en una tabla de frecuencias sin rangos. Una columna con más (un
# identificador, por ejemplo) se rechaza y se pide agrupar en rangos o elegir otra columna.
# DATATAB_MAX_VALORES_DISTINTOS=1000

# Tamaño máximo, en MB, que puede ocupar un .xlsx una vez descomprimido (protección contra zip bombs).
# DATATAB_MAX_DESCOMPRIMIDO_MB=200

# Cuántos archivos se guardan a la vez en memoria; al llegar al tope se borra el menos usado.
# DATATAB_MAX_DATASETS=10

# 1 = el servidor también entrega el frontend (carpeta frontend/); 0 = solo la API.
# DATATAB_SERVIR_FRONTEND=1

# 1 = activa la documentación interactiva de la API en /docs, /redoc y /openapi.json.
# DATATAB_DOCS=1
